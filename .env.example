# Plantilla de Variables de Entorno (Copiar como .env)
# NUNCA subir claves reales a repositorios publicos o compartidos

# URL de tu instancia de Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anonima publica (Safe for browser / Client-side)
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica_aqui

# Clave Service Role (Solo para scripts administrativos locales / NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_aqui

# Identificador del proyecto de Supabase
SUPABASE_PROJECT_REF=tu_project_ref_aqui
